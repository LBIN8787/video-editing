  "changePolicy": "Design changes require a new style version and a new reviewed reference render.",
  "header": {
    "showDate": false,
    "showEpisodeNumber": false
  },
  "visual_policy": "Every scene shows input, action, output, comparison, or a practical condition using diagrams or own file excerpts. No bullet-only scene.",
