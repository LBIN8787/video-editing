  "composition": "ShortsGuideTemplate",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "colors": {
    "ink": "#19231e",
    "paper": "#f3f1e8",
    "accent": "#d4f85a"
  },
  "font": {
    "family": "Noto Sans CJK KR",
    "titleSize": 76,
    "titleWeight": 900,
    "bodySize": 40,
    "captionSize": 50
  },
  "layout": {
    "left": 80,
    "right": 150,
    "width": 850,
    "headerTop": 110,
