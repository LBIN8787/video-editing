    "titleTop": 242,
    "panelTop": 495,
    "panelHeight": 800,
    "captionTop": 1380,
    "sourceBottom": 238,
    "progressBottom": 198,
    "actionTop": 1320
  },
  "motion": {
    "fadeFrames": 5,
    "riseFrames": 12,
    "risePixels": 38,
    "springDamping": 16,
    "springStiffness": 180
