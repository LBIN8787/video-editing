{"1": {"dur": 3.045, "chars": [[0, 0.0], [1, 0.077], [2, 0.153], [3, 0.23], [4, 0.307], [5, 0.383], [6, 1.34], [7, 1.46], [8, 1.58], [9, 1.7], [10, 1.907], [11, 2.113], [12, 2.32], [13, 2.406], [14, 2.491], [15, 2.577], [16, 2.663], [17, 2.749], [18, 2.834]], "narration": "안녕하세요. 비행기 창 구멍 이야기입니다."}, "2": {"dur": 3.372, "chars": [[0, 0.0], [1, 0.13], [2, 0.26], [3, 0.387], [4, 0.513], [5, 0.64], [6, 0.773], [7, 0.907], [8, 0.973], [9, 1.04], [10, 1.47], [11, 1.9], [12, 2.0], [13, 2.1], [14, 2.24], [15, 2.38], [16, 2.54], [17, 2.7], [18, 2.86], [19, 2.936], [20, 3.012], [21, 3.088], [22, 3.164]], "narration": "창가 자리에 앉으면, 창틀 아래 작은 구멍이 보입니다."}, "3": {"dur": 1.801, "chars": [[0, 0.107], [1, 0.107], [2, 0.213], [3, 0.32], [4, 0.5], [5, 0.647], [6, 0.793], [7, 0.94], [8, 1.029], [9, 1.117], [10, 1.206], [11, 1.294], [12, 1.383], [13, 1.471]], "narration": "유리에 왜 구멍을 뚫어 뒀을까요?"}, "4": {"dur": 2.217, "chars": [[0, 0.0], [1, 0.14], [2, 0.28], [3, 0.425], [4, 0.57], [5, 0.72], [6, 0.86], [7, 0.99], [8, 1.12], [9, 1.2], [10, 1.28], [11, 1.378], [12, 1.477], [13, 1.593], [14, 1.71], [15, 1.827], [16, 1.943]], "narration": "그 창은 유리 한 장이 아니라 세 겹입니다."}, "5": {"dur": 3.151, "chars": [[0, 0.0], [1, 0.12], [2, 0.24], [3, 0.36], [4, 0.57], [5, 0.78], [6, 0.92], [7, 1.06], [8, 1.153], [9, 1.247], [10, 1.293], [11, 1.34], [12, 1.607], [13, 1.873], [14, 2.14], [15, 2.4], [16, 2.66], [17, 2.704], [18, 2.748], [19, 2.792], [20, 2.836]], "narration": "구멍은 바깥 창이 아니라, 가운데 창에 있습니다."}, "6": {"dur": 5.432, "chars": [[0, 0.0], [1, 0.079], [2, 0.157], [3, 0.393], [4, 0.629], [5, 0.786], [6, 1.149], [7, 1.513], [8, 1.876], [9, 2.24], [10, 2.44], [11, 2.58], [12, 2.72], [13, 2.86], [14, 3.76], [15, 3.86], [16, 3.96], [17, 4.06], [18, 4.3], [19, 4.418], [20, 4.536], [21, 4.653], [22, 4.771], [23, 4.889], [24, 5.007], [25, 5.124], [26, 5.242]], "narration": "3만 5천 피트. 밖은 0.23, 기내는 0.75기압입니다."}, "7": {"dur": 4.056, "chars": [[0, 0.0], [1, 0.1], [2, 0.2], [3, 0.327], [4, 0.453], [5, 0.58], [6, 0.72], [7,