   "emphasis": [], "visual_type": "card", "source_ref": "", "beat": "fact", "compare_to": "",
   "visual_brief": "구멍 옆 손글씨 '브리더 홀'.", "image_prompt": "", "gap": 0.7},
  {"id": 4, "section": "body-1", "kind": "narration",
   "narration": "답은 창을 옆에서 보면 보입니다. 창은 유리 한 장이 아니라, 세 겹입니다.",
   "quote_en": "", "label": "", "source": null,
   "card": {"type": "headline", "title": "유리 한 장이 아니다", "items": [{"label": "세 겹", "value": "", "sub": "바깥 · 가운데 · 안쪽", "highlight": true}], "note": ""},
   "emphasis": ["세 겹"], "visual_type": "card", "source_ref": "", "beat": "fact", "compare_to": "",
   "visual_brief": "옆에서 본 창 단면 삽화가 도화지에 붙고, 카메라가 세 겹을 훑는다.", "image_prompt": "", "gap": 0.6},
  {"id": 5, "section": "body-1", "kind": "narration",
   "narration": "바깥 창, 가운데 창, 안쪽 창. 바깥 창이 가장 두껍고, 가운데 창은 그 절반쯤입니다.",
   "quote_en": "", "label": "", "source": null,
   "card": {"type": "headline", "title": "세 겹의 두께", "items": [{"label": "두께", "value": "", "sub": "바깥이 가장 두껍다", "highlight": true}], "note": ""},
   "emphasis": [], "visual_type": "card", "source_ref": "", "beat": "fact", "compare_to": "",
   "visual_brief": "단면 삽화에 '바깥 창 / 가운데 창 / 안쪽 창' 이름표가 차례로 붙는다.", "image_prompt": "", "gap": 0.5},
  {"id": 6, "section": "body-1", "kind": "narration",
   "narration": "손으로 만질 수 있는 건 안쪽 창인데요. 이건 힘을 받지 않습니다. 다른 두 창이 긁히지 않게 막아 주는 역할이죠.",
   "quote_en": "", "label": "", "source": null,
   "card": {"type": "headline", "title": "안쪽 창은 긁힘 방지", "items": [{"label": "안쪽 창", "value": "", "sub": "힘을 받지 않는 판", "highlight": true}], "note": ""},
   "emphasis": [], "visual_type": "card", "source_ref": "", "beat": "fact", "compare_to": "",
   "visual_brief": "안쪽 창에 카메라가 붙고, 손글씨 '긁힘만 막는다'.", "image_prompt": "", "gap": 0.6},
  {"id": 7, "section": "body-1", "kind": "narration",
   "narration": "그런데 구멍은 바깥 창이 아니라, 가운데 창 아래쪽에 뚫려 있습니다.",
   "quote_en": "", "label": "", "source": null,
   "card": {"type": "headline", "title": "구멍은 가운데 창", "items": [{"label": "위치", "value": "", "sub": "가운데 창 아래쪽", "highlight": true}], "note": ""},
   "emphasis": ["가운데 창"], "visual_type": "card", "source_ref": "", "beat": "fact", "compare_to": "",
   "visual_brief": "단면 아래쪽 구멍에 빨간 펜 동그라미, 바깥 창에는 X 표시.", "image_prompt": "", "gap": 0.8},
  {"id": 8, "section": "body-2", "kind": "narration",
   "narration": "비행기가 3만 5천 피트를 날 때, 밖의 공기는 0.23기압쯤입니다. 기내는 0.75기압 정도로 맞춰 두고요.",
   "quote_en": "", "label": "", "source": null,
   "card": {"type": "headline", "title": "3만 5천 피트의 두 기압", "items": [{"label": "밖", "value": "0.23기압", "sub": "", "highlight": false}, {"label": "기내", "value": "0.75기압", "sub": "", "highlight": true}], "note": ""},
   "emphasis": ["0.75기압"], "visual_type": "card", "source_ref": "", "beat": "number", "compare_to": "",
   "visual_brief": "기내가 열린 비행기 단면 삽화: 밖에 0.23기압, 기내에 0.75기압 손글씨.", "image_prompt": "", "gap": 0.6},
  {"id": 9, "section": "body-2", "kind": "narration",
   "narration": "기내 공기가 그 구멍으로 스며들면, 두 창 사이 틈도 기내와 같은 압력이 됩니다.",
   "quote_en": "", "label": "", "source": null,
   "card": {"type": "headline", "title": "구멍으로 스며든 공기", "items": [{"label": "사이 틈", "value": "", "sub": "기내와 같은 압력", "highlight": true}], "note": ""},
   "emphasis": [], "visual_type": "card", "source_ref": "", "beat": "cause", "compare_to": "",
   "visual_brief": "단면 삽화: 구멍으로 공기가 들어가 두 창 사이가 노랗게 차오른다.", "image_prompt": "", "gap": 0.5},
  {"id": 10, "section": "body-2", "kind": "narration",
   "narration": "그러면 3만 5천 피트의 압력은 바깥 창 하나가 혼자 견디게 됩니다.",
   "quote_en": "", "label": "", "source": null,
   "card": {"type": "headline", "title": "압력은 바깥 창 하나로", "items": [{"label": "하중", "value": "", "sub": "바깥 창이 혼자 견딘다", "highlight": true}], "note": ""},
   "emphasis": [], "visual_type": "card", "source_ref": "", "beat": "cause", "compare_to": "",
   "visual_brief": "바깥 창에 빨간 압력 화살표가 몰리고 '힘은 여기로'.", "image_prompt": "", "gap": 0.6},
  {"id": 11, "section": "body-2", "kind": "narration",
   "narration": "구멍은 압력이 지나가는 지름길인 셈입니다.",
