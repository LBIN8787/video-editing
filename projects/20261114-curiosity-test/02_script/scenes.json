   "quote_en": "", "label": "", "source": null,
   "card": {"type": "headline", "title": "창틀 아래 작은 구멍", "items": [{"label": "구멍", "value": "", "sub": "손톱만 한 구멍", "highlight": true}], "note": ""},
   "emphasis": [], "visual_type": "card", "source_ref": "", "beat": "fact", "compare_to": "",
   "visual_brief": "창 안쪽 클로즈업, 구멍에 빨간 펜 동그라미.", "image_prompt": "", "gap": 0.6},
  {"id": 2, "section": "hook", "kind": "narration",
