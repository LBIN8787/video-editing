{
 "total": 128.3,
 "lines": [
  {
   "start": 1.38,
   "end": 4.69,
   "t": "왜 매출 하나가 이렇게 중요할까요.",
   "id": "s0"
  },
  {
   "start": 4.71,
   "end": 7.45,
   "t": "그의 평가표 안을 열어 보면 이유가 보입니다.",
   "id": "s1"
  },
  {
   "start": 8.22,
   "end": 11.91,
   "t": "회사 가치를 계산하는 방법은 단순합니다.",
   "id": "s2"
  },
  {
   "start": 11.93,
   "end": 16.03,
   "t": "앞으로 벌 현금을 지금 돈으로 바꿔 더하는 겁니다.",
   "id": "s3"
  },
  {
   "start": 16.05,
   "end": 17.77,
   "t": "그의 표에서 그 합은 1조",
   "id": "s4"
  },
  {
   "start": 17.79,
   "end": 19.93,
   "t": "7,279억 달러입니다.",
   "id": "s5"
  },
  {
   "start": 20.06,
   "end": 21.42,
   "t": "그런데 쪼개 보면,",
   "id": "s6"
  },
  {
   "start": 21.44,
   "end": 23.15,
   "t": "앞으로 10년 동안 버는 현금은",
   "id": "s7"
  },
  {
   "start": 23.17,
   "end": 25.07,
   "t": "23%뿐이고,",
   "id": "s8"
  },
  {
   "start": 25.09,
   "end": 28.24,
   "t": "77%는 10년이 지난 뒤의 가치입니다.",
   "id": "s9"
  },
  {
   "start": 28.38,
   "end": 32.92,
   "t": "10년 뒤의 가치는 10년차 매출과 이익에서 나옵니다.",
   "id": "s10"
  },
  {
   "start": 32.94,
   "end": 35.81,
   "t": "그래서 2036년 매출이 흔들리면 값의",
   "id": "s11"
  },
  {
   "start": 35.83,
   "end": 38.67,
   "t": "4분의 3이 같이 흔들립니다.",
   "id": "s12"
  },
  {
   "start": 38.69,
   "end": 41.95,
   "t": "그가 '매출이 안 오면 다 무너진다'고 한 이유입니다.",
   "id": "s13"
  },
  {
   "start": 42.72,
   "end": 46.17,
   "t": "여기서부터는 이 채널의 계산입니다.",
   "id": "s14"
  },
  {
   "start": 46.19,
   "end": 48.79,
   "t": "그가 공개한 표를 그대로 다시 짜서 돌렸더니",
   "id": "s15"
  },
  {
   "start": 48.81,
   "end": 51.53,
   "t": "주당 75달러 87센트,",
   "id": "s16"
  },
  {
   "start": 51.55,
   "end": 55.64,
   "t": "그의 76달러와 1% 안으로 맞았습니다.",
   "id": "s17"
  },
  {
   "start": 55.66,
   "end": 58.11,
   "t": "이 틀에서 다른 건 그대로 두고 매출 길만",
   "id": "s18"
  },
  {
   "start": 58.13,
   "end": 59.3,
   "t": "바꿔 보겠습니다.",
   "id": "s19"
  },
  {
   "start": 59.44,
   "end": 62.79,
   "t": "10년차 매출 1조면 76달러.",
   "id": "s20"
  },
  {
   "start": 62.81,
   "end": 64.82,
   "t": "8,000억이면 56달러,",
   "id": "s21"
  },
  {
   "start": 64.84,
   "end": 66.8,
   "t": "6,000억이면 37달러입니다.",
   "id": "s22"
  },
  {
   "start": 66.93,
   "end": 68.39,
   "t": "그의 길의 절반,",
   "id": "s23"
  },
  {
   "start": 68.41,
   "end": 71.34,
   "t": "5,000억 달러면 27달러 50센트,",
   "id": "s24"
  },
  {
   "start": 71.36,
   "end": 74.01,
   "t": "4,000억이면 18달러.",
   "id": "s25"
  },
  {
   "start": 74.03,
   "end": 78.75,
   "t": "매출이 반이 되면 값은 3분의 1 남짓으로 줄어듭니다.",
   "id": "s26"
  },
  {
   "start": 78.77,
   "end": 81.65,
   "t": "매출보다 값이 훨씬 크게 움직이는 겁니다.",
   "id": "s27"
  },
  {
   "start": 81.79,
   "end": 84.61,
   "t": "왜 이렇게 크게 움직일까요.",
   "id": "s28"
  },
  {
   "start": 84.63,
   "end": 87.42,
   "t": "컴퓨트 약정 같은 큰 고정비와 빚은 매출이",
   "id": "s29"
  },
  {
   "start": 87.44,
   "end": 90.74,
   "t": "줄어도 그대로 빼야 하기 때문입니다.",
   "id": "s30"
  },
  {
   "start": 90.76,
   "end": 93.3,
   "t": "그가 처음 평가 때 그린 최악의 길,",
   "id": "s31"
  },
  {
   "start": 93.32,
   "end": 95.64,
   "t": "10년 뒤 매출 2,000억 달러에서는 지분",
   "id": "s32"
  },
  {
   "start": 95.66,
   "end": 98.85,
   "t": "가치가 마이너스 3,730억 달러,",
   "id": "s33"
  },
  {
   "start": 98.87,
   "end": 100.86,
   "t": "회사가 버틸 수 없다고 적었습니다.",
   "id": "s34"
  },
  {
   "start": 101.62,
   "end": 104.42,
   "t": "이번엔 거꾸로 풀어 봅니다.",
   "id": "s35"
  },
  {
   "start": 104.44,
   "end": 107.37,
   "t": "11월 25일 주가 82달러 79센트를 이",
   "id": "s36"
  },
  {
   "start": 107.39,
   "end": 108.61,
   "t": "틀에 넣으면,",
   "id": "s37"
  },
  {
   "start": 108.63,
   "end": 112.63,
   "t": "2036년 매출이 약 1조 770억 달러여야 합니다.",
   "id": "s38"
  },
  {
   "start": 112.76,
   "end": 114.87,
   "t": "그가 스스로 낙관의 모자를 썼다고 한",
   "id": "s39"
  },
  {
   "start": 114.89,
   "end": 117.81,
   "t": "1조 달러보다 7% 정도 더 많고,",
   "id": "s40"
  },
  {
   "start": 117.83,
   "end": 119.95,
   "t": "지금 세계에서 가장 많이 파는 회사들의",
   "id": "s41"
  },
  {
   "start": 119.97,
   "end": 122.56,
   "t": "1.5배입니다.",
   "id": "s42"
  },
  {
   "start": 122.58,
   "end": 124.28,
   "t": "공모가보다 내려왔어도,",
   "id": "s43"
  },
  {
   "start": 124.3,
   "end": 126.69,
   "t": "주가는 여전히 가장 밝은 길을 조금 넘게",
   "id": "s44"
  },
  {
   "start": 126.71,
   "end": 127.96,
   "t": "깔고 있는 셈입니다.",
   "id": "s45"
  }
 ]
}