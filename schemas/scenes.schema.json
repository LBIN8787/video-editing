{
  "$defs": {
    "Card": {
      "properties": {
        "type": {
          "description": "chart | number_compare | flow | table | bars | line | headline | text | analogy (analogy: items[0]=실제 숫자·개념, items[1]=일상의 비유)",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "description": "카드 제목 (24자 이내)",
          "title": "Title",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/CardItem"
          },
          "title": "Items",
          "type": "array"
        },
        "note": {
          "description": "아래 한 줄 메모 (36자 이내, 없으면 빈 문자열)",
          "title": "Note",
          "type": "string"
        },
        "ticker": {
          "default": "",
          "description": "chart 카드: 시세 종목 코드 (NVDA, 005930.KS, ^IXIC 등). 렌더러가 실제 가격을 받아 그린다",
          "title": "Ticker",
          "type": "string"
        },
        "period": {
          "default": "",
          "description": "chart 카드: 5d | 1mo | 3mo | 6mo | 1y | 2y | 5y",
          "title": "Period",
          "type": "string"
        },
        "icon": {
          "default": "",
          "description": "text 카드의 큰 아이콘 이름 (선택)",
          "title": "Icon",
          "type": "string"
        },
        "unit": {
          "default": "",
          "description": "line 카드 값의 단위 (예: 달러, %, USD, KRW)",
          "title": "Unit",
          "type": "string"
        },
        "start": {
          "default": "",
          "description": "chart 카드: 과거 기간 시작 YYYY-MM-DD (과거 사례용, 예: 1999-06-01). 비우면 오늘까지 period",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "default": "",
          "description": "chart 카드: 과거 기간 끝 YYYY-MM-DD (비우면 오늘)",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "type",
        "title",
        "items",
        "note"
      ],
      "title": "Card",
      "type": "object"
    },
    "CardItem": {
      "properties": {
        "label": {
          "description": "항목 이름 (12자 이내). chart 카드면 표시할 날짜 YYYY-MM-DD",
          "title": "Label",
          "type": "string"
        },
        "value": {
          "description": "값 (10자 이내). bars·line 은 순수 숫자",
          "title": "Value",
          "type": "string"
        },
        "sub": {
          "description": "보조 설명 (18자 이내)",
          "title": "Sub",
          "type": "string"
        },
        "highlight": {
          "title": "Highlight",
          "type": "boolean"
        },
        "icon": {
          "default": "",
          "description": "선 아이콘 이름 (ytflow.stages.icons.names(), 예: factory, cpu, zap, trending-down). 없으면 빈 문자열",
          "title": "Icon",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value",
        "sub",
        "highlight"
      ],
      "title": "CardItem",
      "type": "object"
    },
    "Scene": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "section": {
          "description": "hook / intro / body-1 ... / outro",
          "title": "Section",
          "type": "string"
        },
        "kind": {
          "description": "narration(내레이션) | quote(원본 발언: 원래 소리 + 번역 자막)",
          "title": "Kind",
          "type": "string"
        },
        "narration": {
          "description": "내레이션 문장. kind=quote 이면 원문 발언의 한국어 번역",
          "title": "Narration",
          "type": "string"
        },
        "quote_en": {
          "description": "kind=quote 일 때 원문 발언 (아니면 빈 문자열)",
          "title": "Quote En",
          "type": "string"
        },
        "label": {
          "description": "화면 왼쪽 위 출처 라벨 'YYYY.MM.DD · 출처'",
          "title": "Label",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "description": "원본 영상을 쓸 때 (visual_type=source_video 또는 kind=quote)"
        },
        "card": {
          "anyOf": [
            {
              "$ref": "#/$defs/Card"
            },
            {
              "type": "null"
            }
          ],
          "description": "visual_type=card 일 때 검은 배경 인포 카드 내용"
        },
        "emphasis": {
          "description": "자막에서 색으로 강조할 단어",
          "items": {
            "type": "string"
          },
          "title": "Emphasis",
          "type": "array"
        },
        "visual_type": {
          "description": "source_video | card | screenshot | stock | ai_image",
          "title": "Visual Type",
          "type": "string"
        },
        "beat": {
          "default": "",
          "description": "이 장면이 논리에서 하는 일: fact | number | why | so_what | analogy | precedent | jargon | question | quote | summary | counter | takeaway | next",
          "title": "Beat",
          "type": "string"
        },
        "compare_to": {
          "default": "",
          "description": "beat=number 일 때 비교 기준 (예: '작년 같은 분기 251억 달러', '삼성전자 시총의 약 2배')",
          "title": "Compare To",
          "type": "string"
        },
        "visual_brief": {
          "description": "편집자/이미지 생성기용 화면 지시",
          "title": "Visual Brief",
          "type": "string"
        },
        "image_prompt": {
          "description": "AI 이미지 생성 프롬프트 (영문)",
          "title": "Image Prompt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "section",
        "kind",
        "narration",
        "quote_en",
        "label",
        "source",
        "card",
        "emphasis",
        "visual_type",
        "visual_brief",
        "image_prompt"
      ],
      "title": "Scene",
      "type": "object"
    },
    "Source": {
      "properties": {
        "url": {
          "description": "원본 영상 URL",
          "title": "Url",
          "type": "string"
        },
        "start": {
          "description": "시작 'm:ss' (모르면 빈 문자열)",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "description": "끝 'm:ss' (모르면 빈 문자열)",
          "title": "End",
          "type": "string"
        },
        "find": {
          "description": "구간을 모를 때 자막에서 찾을 키워드 (아니면 빈 문자열)",
          "title": "Find",
          "type": "string"
        },
        "length": {
          "description": "클립 길이(초)",
          "title": "Length",
          "type": "number"
        },
        "query": {
          "default": "",
          "description": "url 을 모를 때 YouTube 에서 찾을 검색어 (sources 단계가 영상을 고른다)",
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "url",
        "start",
        "end",
        "find",
        "length"
      ],
      "title": "Source",
      "type": "object"
    },
    "Term": {
      "properties": {
        "term": {
          "description": "어려운 말 (예: 잉여현금흐름)",
          "title": "Term",
          "type": "string"
        },
        "plain": {
          "description": "중학생도 알아듣는 한 문장 풀이 (예: 번 돈에서 공장·장비 사는 데 쓴 돈을 빼고 남은 돈)",
          "title": "Plain",
          "type": "string"
        },
        "scene_id": {
          "description": "이 말을 처음 풀어 주는 장면 id (처음 나오는 장면과 같거나 바로 앞)",
          "title": "Scene Id",
          "type": "integer"
        }
      },
      "required": [
        "term",
        "plain",
        "scene_id"
      ],
      "title": "Term",
      "type": "object"
    }
  },
  "properties": {
    "title_working": {
      "title": "Title Working",
      "type": "string"
    },
    "core_message": {
      "default": "",
      "description": "시청자가 영상을 다 보고 기억할 한 문장 (숫자 1개 포함, 40자 안팎)",
      "title": "Core Message",
      "type": "string"
    },
    "logic": {
      "description": "논리 구조 3~6단계: 무슨 일(사실·숫자) → 왜(원인) → 그래서(결과) → 전에도?(과거 사례) → 반론 → 의미",
      "items": {
        "type": "string"
      },
      "title": "Logic",
      "type": "array"
    },
    "glossary": {
      "description": "대본에 나오는 어려운 말과 쉬운 풀이",
      "items": {
        "$ref": "#/$defs/Term"
      },
      "title": "Glossary",
      "type": "array"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "title": "Scenes",
      "type": "array"
    }
  },
  "required": [
    "title_working",
    "scenes"
  ],
  "title": "Script",
  "type": "object"
}